# Copy to .env (git-ignored) for local runs. Fill from your password manager.

INFLUXDB_HOST=35.238.159.210
INFLUXDB_PORT=8086

# Per-function InfluxDB writer accounts
INFLUXDB_UPLOADFUNCTION_PASSWORD=   # user: uploadfunction (WRITE temperatures)
INFLUXDB_SIGNALS_PASSWORD=          # user: signals (WRITE temperatures)
INFLUXDB_WEMOS_PASSWORD=            # user: wemos (READ temperatures) — temp-led
INFLUXDB_WSPR_PASSWORD=             # user: wspr (WRITE wspr) — retired
INFLUXDB_RADIO_PASSWORD=            # user: radio (WRITE radio) — retired

# Ambient Weather
AMBIENT_APPLICATION_KEY=
AMBIENT_API_KEY=                    # Tommy
AMBIENT_API_KEY_GARRETT=
AMBIENT_API_KEY_NICK=

# Thermoworks Signals (Firebase smoke-cloud)
THERMOWORKS_EMAIL=
THERMOWORKS_PASSWORD=
THERMOWORKS_FIREBASE_API_KEY=
